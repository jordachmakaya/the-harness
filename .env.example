# Local runtime configuration — values are intentionally non-secret defaults.
SHOKUNIN_COCKPIT_PORT=3333
SHOKUNIN_SPILL_DIR=.shokunin/spill

# Configure only the providers you use. Keep real values in a local ignored .env
# file or a platform keyring; never commit them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# env-sync is a maintainer-operated tool. Use the explicit CLI flag and --dry-run
# before synchronizing local secrets to GitHub Actions.
# ENV_SYNC_PROVIDER=github
